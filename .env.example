# Copy values into the actual process environment. The Go API does not load .env automatically.
APP_ENV=production
PORT=8080
# Production containers listen publicly; development defaults to 127.0.0.1.
LISTEN_HOST=0.0.0.0
PUBLIC_BASE_URL=https://naosemetanobrasil.online
DATABASE_URL=postgres://app_user:password@your-pooler.supabase.com:5432/postgres?sslmode=verify-full
DATABASE_MAX_CONNECTIONS=5
INSTAGRAM_OFFICIAL_HANDLE=naosemetanobrasil
# Enable webhook only after configuring the Meta app and secrets below.
INSTAGRAM_VERIFICATION_MODE=manual
# META_APP_SECRET=<Meta app secret, server only>
# META_WEBHOOK_VERIFY_TOKEN=<independent random token, at least 32 characters>
# INSTAGRAM_ACCESS_TOKEN=<professional account messaging token, server only>
# INSTAGRAM_ACCOUNT_ID=<numeric professional account ID, not @username>
# META_GRAPH_API_VERSION=<explicit supported version from Meta dashboard, e.g. v25.0>
VERIFICATION_CODE_PEPPER=replace-with-at-least-32-random-bytes
# Base64 of an independently generated 32-byte key.
TOTP_ENCRYPTION_KEY=replace-with-base64-key
# Only known reverse proxy networks; never trust all addresses.
TRUSTED_PROXY_CIDRS=
FRONTEND_DIR=web/dist
