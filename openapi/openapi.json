    "/v1/webhooks/instagram": {
      "get": {
        "summary": "Validação de inscrição do webhook Meta (somente no modo webhook)",
        "security": [],
        "parameters": [
          {
            "in": "query",
            "name": "hub.mode",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "subscribe"
              ]
            }
          },
          {
            "in": "query",
            "name": "hub.verify_token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "hub.challenge",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Challenge devolvido como texto puro",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Token ou parâmetros inválidos"
          },
          "404": {
            "description": "Integração desativada"
          }
        }
      },
      "post": {
        "summary": "Receber código de vínculo enviado por mensagem direta ao Instagram oficial",
        "description": "Valida HMAC-SHA256 sobre os bytes originais com o App Secret. Filtra a conta destinatária, consulta a identidade do remetente na Graph API e persiste a conferência e a deduplicação em transação. Não conclui o vínculo: a confirmação final continua autenticada. Não envia mensagens de resposta. Limite de 256 KiB e 100 eventos por entrega. A consulta de perfil pode ser repetida após falha transitória; confirmações já gravadas são idempotentes.",
        "security": [],
        "parameters": [
          {
            "in": "header",
            "name": "X-Hub-Signature-256",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^sha256=[0-9a-fA-F]{64}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Payload Meta object=instagram, entry[].id e entry[].messaging[] com sender.id, recipient.id, timestamp em milissegundos e message.mid/text. Campos adicionais são tolerados para compatibilidade com Meta."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "EVENT_RECEIVED: evento persistido, já processado ou não aplicável",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "JSON inválido"
          },
          "403": {
            "description": "Assinatura ausente ou inválida"
          },
          "404": {
            "description": "Integração desativada"
          },
          "413": {
            "description": "Corpo ou quantidade de eventos excede limite"
          },
          "503": {
            "description": "Falha transitória; Meta pode reenviar. Nenhum sucesso é confirmado antes do commit."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-nsm_session",
        "description": "Produção: cookie __Host- com Secure, HttpOnly, SameSite=Lax, Path=/ e sem Domain. Em localhost HTTP de desenvolvimento, o nome é nsm_session."
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "member",
              "admin"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "username",
          "display_name",
          "role",
          "created_at"
        ],
        "additionalProperties": false
      },
      "Challenge": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "expected_handle": {
            "type": "string"
          },
          "observed_handle": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "awaiting_confirmation",
              "verified",
              "expired",
              "rejected",
              "cancelled"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "sent_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "verification_method": {
            "type": "string",
            "enum": [
              "manual_dm",
              "instagram_webhook"
            ]
          },
          "verification_mode": {
            "type": "string",
            "enum": [
              "manual",
              "webhook"
            ]
          }
        },
        "required": [
          "id",
          "expected_handle",
          "observed_handle",
          "status",
          "created_at",
          "expires_at",
          "sent_at"
        ],
        "additionalProperties": false
      },
      "SocialProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "platform": {
            "type": "string",
            "enum": [
              "instagram"
            ]
          },
          "handle": {
            "type": "string"
          },
          "verification_method": {
            "type": "string",
            "enum": [
              "manual_dm",
              "instagram_webhook"
            ]
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          },
          "public_visibility": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "id",
          "platform",
          "handle",
          "verification_method",
          "verified_at",
          "public_visibility"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "RegistrationInput": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32,
            "pattern": "^[a-zA-Z0-9_]{3,32}$"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          },
          "display_name": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "username",
          "password"
        ],
        "additionalProperties": false
      },
      "Registration": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "recovery_codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 10,
            "maxItems": 10
          }
        },
        "required": [
          "user",
          "recovery_codes"
        ],
        "additionalProperties": false
      },
      "LoginInput": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "writeOnly": true
          },
          "totp": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "writeOnly": true
          }
        },
        "required": [
          "username",
          "password"
        ],
        "additionalProperties": false
      },
      "Login": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "csrf_token": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "user",
          "csrf_token",
          "expires_at"
        ],
        "additionalProperties": false
      },
      "RecoveryInput": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32,
            "pattern": "^[a-zA-Z0-9_]{3,32}$"
          },
          "recovery_code": {
            "type": "string",
            "maxLength": 100,
            "writeOnly": true
          },
          "new_password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "username",
          "recovery_code",
          "new_password"
        ],
        "additionalProperties": false
      },
      "ChallengeInput": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 31
          }
        },
        "required": [
          "handle"
        ],
        "additionalProperties": false
      },
      "IssuedChallenge": {
        "type": "object",
        "properties": {
          "challenge": {
            "$ref": "#/components/schemas/Challenge"
          },
          "code": {
            "type": "string",
            "writeOnly": false,
            "description": "Exibido somente uma vez; enviar ao perfil oficial. Não aparece em consultas posteriores."
          },
          "official_handle": {
            "type": "string"
          },
          "direct_url": {
            "type": "string",
            "format": "uri"
          },
          "verification_mode": {
            "type": "string",
            "enum": [
              "manual",
              "webhook"
            ]
          }
        },
        "required": [
          "challenge",
          "code",
          "official_handle",
          "direct_url",
          "verification_mode"
        ],
        "additionalProperties": false
      },
      "ObservationInput": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 100,
            "writeOnly": true
          },
          "observed_handle": {
            "type": "string"
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "code",
          "observed_handle",
          "reference"
        ],
        "additionalProperties": false
      },
      "RejectionInput": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "reason"
        ],
        "additionalProperties": false
      },
      "Me": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "instagram_profile": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SocialProfile"
              },
              {
                "type": "null"
              }
            ]
          },
          "csrf_token": {
            "type": "string"
          }
        },
        "required": [
          "user",
          "instagram_profile",
          "csrf_token"
        ],
        "additionalProperties": false
      },
      "Queue": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "expected_handle": {
                      "type": "string"
                    },
                    "observed_handle": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "awaiting_confirmation",
                        "verified",
                        "expired",
                        "rejected",
                        "cancelled"
                      ]
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "sent_at": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "user_id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "id",
                    "expected_handle",
                    "observed_handle",
                    "status",
                    "created_at",
                    "expires_at",
                    "sent_at",
                    "user_id"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "limit": {
            "type": "integer",
            "const": 50
          }
        },
        "required": [
          "items",
          "limit"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      }
    }
  }
}
